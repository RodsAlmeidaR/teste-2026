<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema RH - Cristália</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    
    <div class="container mt-5">
        <h1 class="text-center mb-4 text-primary">Gestão de Colaboradores</h1>

        <div class="d-flex justify-content-end mb-3">
            <a href="/adicionar" class="btn btn-success">
                + Novo Colaborador
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Nome</th>
                            <th>RE</th>
                            <th>Cargo</th>
                            <th>Salário (R$)</th>
                            <th>Empresa</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Ações</th>
                            <th class="text-center">Editar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% colaboradores.forEach(function(colaborador) { %>
                            <tr id="linha-<%= colaborador.id %>">
                                <td><%= colaborador.nome %></td>
                                <td><%= colaborador.re %></td>
                                <td><%= colaborador.cargo %></td>
                                <td>R$ <%= colaborador.salario_atual.toFixed(2) %></td>
                                <td><%= colaborador.empresa %></td>
                                
                                <td class="text-center">
                                    <span id="status-badge-<%= colaborador.id %>" 
                                          class="badge <%= colaborador.status === 'Ativo' ? 'bg-success' : 'bg-danger' %>">
                                        <%= colaborador.status %>
                                    </span>
                                    <small id="data-inativacao-<%= colaborador.id %>" class="d-block text-muted" style="font-size: 0.75em;">
                                        <%= colaborador.data_desativacao ? colaborador.data_desativacao : '' %>
                                    </small>
                                </td>
                                
                                <td class="text-center">
                                    <% if (colaborador.status === 'Ativo') { %>
                                        <button id="btn-inativar-<%= colaborador.id %>"
                                                class="btn btn-danger btn-sm"
                                                onclick="inativarColaborador(<%= colaborador.id %>)">
                                            Inativar
                                        </button>
                                    <% } else { %>
                                        <button class="btn btn-secondary btn-sm" disabled>Inativado</button>
                                    <% } %>
                                </td>

                                <td class="text-center">
                                    <a href="/editar/<%= colaborador.id %>" class="btn btn-sm btn-warning">Editar</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function inativarColaborador(id) {
            //confirmação simples
            if (!confirm('Tem certeza que deseja inativar este colaborador?')) {
                return;
            }

            //envia o comando para o servidor
            fetch('/inativar/' + id, {
                method: 'POST'
            })
            .then(response => response.json()) //converte a resposta para JSON
            .then(data => {
                if (data.success) {
                    //sucesso
                    
                    //muda a cor e o texto do badge
                    const badge = document.getElementById('status-badge-' + id);
                    badge.className = 'badge bg-danger';
                    badge.innerText = 'Inativo';

                    //insere a data recebida do servidor
                    const spanData = document.getElementById('data-inativacao-' + id);
                    if(spanData) spanData.innerText = data.data;

                    //desabilita o botão para não clicar de novo
                    const btn = document.getElementById('btn-inativar-' + id);
                    if (btn) {
                        btn.className = 'btn btn-secondary btn-sm';
                        btn.innerText = 'Inativado';
                        btn.disabled = true;
                    }

                } else {
                    alert('Erro ao inativar: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Erro:', error);
                alert('Erro na comunicação com o servidor.');
            });
        }
    </script>

</body>
</html>