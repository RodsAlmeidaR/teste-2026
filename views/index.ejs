<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema RH - Cristália</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    
    <div class="container mt-05">
        <h1 class="text-center mb-4 text-primary">Gestão de Colaboradores</h1>

        <div class="d-flex justify-content-end mb-3">
            <a href="/adicionar" class ="btn btn-success">
                + Novo Colaborador
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Nome</th>
                            <th>RE</th>
                            <th>Cargo</th>
                            <th>Salário (R$)</th>
                            <th>Empresa</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thred>
                    <tbody>
                        <% colaboradores.forEach(function(colaborador) { %>
                            <tr>
                                <td><%= colaborador.nome %></td>
                                <td><%= colaborador.re %></td>
                                <td><%= colaborador.cargo %></td>
                                <td><%= colaborador.salario_atual.toFixed(2) %></td>
                                <td><%= colaborador.empresa %></td>
                                <td><%= colaborador.status %></td>
                                <td>
                                    <span class="badge <%= colaborador.status === 'Ativo' ? 'bg-success' : 'bg-danger' %>">
                                        <%= colaborador.status %>
                                    </span>
                                </td>
                                <td>
                                    <a href="/deletar/<%= colaborador.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Tem certeza?');">Deletar</a>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-warning">Editar</button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>