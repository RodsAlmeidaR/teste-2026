<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Colaborador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    
    <div class="container mt-5">
        <h2 class="text-center mb-4 text-primary">Editar Colaborador</h2>

        <div class="text-center mb-4">
            <% if (colaborador.status === 'Inativo') { %>
                <span class="badge bg-danger fs-5">Status: Inativo</span>
            <% } else { %>
                <span class="badge bg-success fs-5">Status: Ativo</span>
            <% } %>
        </div>

        <form action="/editar/<%= colaborador.id %>" method="POST">
            
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">Dados Cadastrais</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nome:</label>
                            <input type="text" name="nome" class="form-control" value="<%= colaborador.nome %>" required>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">RE:</label>
                            <input type="text" name="re" class="form-control" value="<%= colaborador.re %>" required>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Empresa:</label>
                            <input type="text" name="empresa" class="form-control" value="<%= colaborador.empresa %>" readonly>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Cargo:</label>
                            <input type="text" name="cargo" class="form-control" value="<%= colaborador.cargo %>" required>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-primary mb-4">
                <div class="card-header bg-primary text-white">Reajuste Salarial</div>
                <div class="card-body bg-white">
                    <div class="row align-items-end">
                        <div class="col-md-4 mb-3">
                            <label class="fw-bold">Salário Atual (R$):</label>
                            <input type="number" step="0.01" class="form-control bg-light" value="<%= colaborador.salario_atual %>" readonly>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="text-primary fw-bold">% de Aumento:</label>
                            <input type="number" name="percentual" step="0.01" class="form-control" 
                                   <%= colaborador.status === 'Inativo' ? 'disabled' : '' %>>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="text-success fw-bold">Bônus Extra (R$):</label>
                            <% if (colaborador.salario_atual < 1500 && colaborador.status === 'Ativo') { %>
                                <input type="number" name="bonus" step="0.01" class="form-control">
                            <% } else { %>
                                <input type="number" name="bonus" class="form-control" disabled placeholder="Bloqueado">
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <% if (historico && historico.length > 0) { %>
            <div class="card shadow-sm mb-5">
                <div class="card-header bg-dark text-white">Histórico de Alterações</div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0 text-center">
                        <thead>
                            <tr>
                                <th>Data/Hora</th>
                                <th>Salário Anterior</th>
                                <th>Novo Salário</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% historico.forEach(function(item) { %>
                                <tr>
                                    <td><%= item.data_alteracao %></td>
                                    <td class="text-danger">R$ <%= item.salario_anterior.toFixed(2) %></td>
                                    <td class="text-success fw-bold">R$ <%= item.salario_novo.toFixed(2) %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% } %>

            <div class="d-flex justify-content-between mb-5">
                <a href="/" class="btn btn-secondary">Voltar</a>

                <% if (colaborador.status === 'Inativo') { %>
                    <button type="button" class="btn btn-secondary btn-lg" disabled title="Colaborador Inativo - Apenas Leitura">
                        Inativo (Apenas Leitura)
                    </button>
                <% } else { %>
                    <button type="submit" class="btn btn-success btn-lg">Salvar Alterações</button>
                <% } %>
            </div>

        </form>
    </div>
</body>
</html>